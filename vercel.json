{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/init",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/closings/remind",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/digest",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/attendance/watch",
      "schedule": "45 21 * * *"
    },
    {
      "path": "/api/attendance/watch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/pos/cron",
      "schedule": "40 4 * * *"
    }
  ]
}
