# Volitelné nastavení. Bez něj aplikace běží, jen se dané funkce nenabízejí.

# ---- Karta hosta v Apple Wallet (lib/walletKonfig.ts) -------------------------
# Všechny čtyři povinné proměnné dohromady, jinak se tlačítko „Přidat do Apple Wallet“ nezobrazí.
# Potřebuješ účet Apple Developer: Identifiers -> Pass Type IDs, k němu certifikát (.p12 s klíčem).
# APPLE_PASS_TYPE_ID=pass.app.managero.karta
# APPLE_TEAM_ID=ABCDE12345
# APPLE_PASS_CERT_P12_BASE64=        # base64 -w0 certifikat.p12
# APPLE_PASS_CERT_PASSWORD=          # heslo k .p12 (smí být prázdné)
# APPLE_WWDR_CERT_PEM=               # certifikát Apple WWDR v PEM, zalomení řádků psaná jako \n

# ---- Karta hosta v Google Wallet ---------------------------------------------
# Všechny tři dohromady. Potřebuješ Google Pay & Wallet Console (vydavatel) a servisní účet s přístupem k Wallet API.
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet@projekt.iam.gserviceaccount.com
# GOOGLE_WALLET_PRIVATE_KEY=         # privátní klíč servisního účtu (PEM), zalomení řádků psaná jako \n
