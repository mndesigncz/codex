# Managero — proměnné prostředí
#
# Ostré nasazení: Vercel → Project → Settings → Environment Variables.
# Místní vývoj: zkopíruj do .env.local. Hodnoty nikdy necommituj.
# Stav nastavení bez hodnot ukáže GET /api/health (povinneChybi, funkce).

# ---- Povinné -------------------------------------------------------------------
DATABASE_URL=                      # Neon Postgres, connection string s ?sslmode=require
NEXTAUTH_SECRET=                   # náhodný řetězec ≥ 32 znaků (openssl rand -base64 32); podpisy relací a odkazů
NEXTAUTH_URL=https://www.managero.app
NEXT_PUBLIC_APP_URL=https://www.managero.app   # odkazy v e-mailech a pushích
CRON_SECRET=                       # Vercel ho posílá cronům z vercel.json; bez něj se úlohy odmítnou

# ---- Doporučené ----------------------------------------------------------------
APP_SECRET_KEY=                    # šifrování klíčů k pokladně v DB (AES-256-GCM); bez něj se použije NEXTAUTH_SECRET
# NEXT_PUBLIC_SITE_URL=            # jen při změně domény (výchozí https://www.managero.app)
SUPERADMIN_USER_IDS=               # id účtů správců platformy, oddělené čárkou
ADMIN_API_TOKEN=                   # Bearer token pro administrátorské API a MCP; bez něj je API zavřené

# ---- E-maily (Resend) ----------------------------------------------------------
# Bez nich nechodí pozvánky, reset hesla, uzávěrky ani novinky. Doména musí být v Resendu ověřená (DNS).
RESEND_API_KEY=
EMAIL_FROM=Managero <noreply@managero.app>

# ---- Platby (Stripe) -----------------------------------------------------------
# Produkty s lookup_key pro_monthly, pro_yearly, max_monthly, max_yearly; kupon MAX30.
# Webhook na /api/billing/webhook (události checkout.session.completed, customer.subscription.*, invoice.*).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Soubory (Vercel Blob) -----------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---- Push v prohlížeči (Web Push) ----------------------------------------------
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:podpora@managero.app

# ---- Push v nativních aplikacích (lib/nativniPush.ts) -----------------------------
# iOS: Apple Developer → Keys → Apple Push Notifications service (.p8).
# APNS_KEY_P8=                     # obsah .p8, zalomení řádků psaná jako \n
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC_MANAGERO=app.managero.app      # jen když se liší od bundle ID
# APNS_TOPIC_CLIENT=app.managero.client
# Android: Firebase → Project settings → Service accounts → Generate new private key.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT=             # celý JSON servisního účtu na jednom řádku

# ---- Údaje provozovatele (lib/firma.ts) ------------------------------------------
# Dokud chybí, právní stránky ukazují zástupná pole a banner „Návrh“.
FIRMA_NAZEV=
FIRMA_ICO=
FIRMA_ADRESA=
FIRMA_EMAIL_PODPORY=
FIRMA_REGION_DAT=                  # např. „EU (Frankfurt)“ podle regionu Neonu a Vercelu

# ---- Karta hosta v Apple Wallet (lib/walletKonfig.ts) -------------------------
# Všechny čtyři povinné proměnné dohromady, jinak se tlačítko „Přidat do Apple Wallet“ nezobrazí.
# Potřebuješ účet Apple Developer: Identifiers -> Pass Type IDs, k němu certifikát (.p12 s klíčem).
# APPLE_PASS_TYPE_ID=pass.app.managero.karta
# APPLE_TEAM_ID=ABCDE12345
# APPLE_PASS_CERT_P12_BASE64=        # base64 -w0 certifikat.p12
# APPLE_PASS_CERT_PASSWORD=          # heslo k .p12 (smí být prázdné)
# APPLE_WWDR_CERT_PEM=               # certifikát Apple WWDR v PEM, zalomení řádků psaná jako \n

# ---- Karta hosta v Google Wallet ---------------------------------------------
# Všechny tři dohromady. Potřebuješ Google Pay & Wallet Console (vydavatel) a servisní účet s přístupem k Wallet API.
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet@projekt.iam.gserviceaccount.com
# GOOGLE_WALLET_PRIVATE_KEY=         # privátní klíč servisního účtu (PEM), zalomení řádků psaná jako \n

# ---- Bezpečnost účtů (spuštění, balík S) ----
# Bez nových proměnných. Ověření e-mailu vedení se nabízí jen s RESEND_API_KEY (výš);
# přímé nahrávání velkých souborů do úložiště (video, sken) jen s BLOB_READ_WRITE_TOKEN (výš) —
# bez něj se nahrává jako dřív přes server (do 4,5 MB).
